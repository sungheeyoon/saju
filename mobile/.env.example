# `.env.local` 로 복사해 채운다 — 값은 뿌리의 `.env.development.local` 공개 값과 같다. 비밀은 여기 없다
# EAS 빌드는 이 파일을 못 본다(git 에 없다) — 같은 값을 `eas env:create` 로 그 프로필의 environment 에 넣는다
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# `<Supabase 주소>/auth/v1/authorize?provider=google` 의 리디렉션에서 읽힌다
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS 빌드만 — Google 콘솔의 iOS 클라이언트. 앞은 `….apps.googleusercontent.com`, 뒤는 그 역순 `com.googleusercontent.apps.…`
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
# 운영 주소(`docs/ops/runbook/domain.md` 맨 위) — 가입 화면의 처리방침을 연다
EXPO_PUBLIC_SITE_URL=
