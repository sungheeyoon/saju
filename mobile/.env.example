# `.env.local` 로 복사해 채운다 — 값은 뿌리의 `.env.development.local` 공개 값과 같다. 비밀은 여기 없다
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# `<Supabase 주소>/auth/v1/authorize?provider=google` 의 리디렉션에서 읽힌다
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# 운영 주소(`docs/ops/runbook/domain.md` 맨 위) — 이용약관 제1조가 적는다
EXPO_PUBLIC_SITE_URL=
# 사업자 정보 — 값은 웹 배포의 `BUSINESS_*` 와 같다. 저장소에 안 적는다. 비면 약관 · 환불정책에서 그 줄이 안 선다(ADR 0172)
EXPO_PUBLIC_BUSINESS_TRADE_NAME=
EXPO_PUBLIC_BUSINESS_REPRESENTATIVE=
EXPO_PUBLIC_BUSINESS_REGISTRATION_NUMBER=
EXPO_PUBLIC_BUSINESS_ADDRESS=
EXPO_PUBLIC_BUSINESS_PHONE=
EXPO_PUBLIC_BUSINESS_MAIL_ORDER_NUMBER=
EXPO_PUBLIC_BUSINESS_HOSTING_PROVIDER=
EXPO_PUBLIC_BUSINESS_DISCLOSURE_URL=
