{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@input/*": [
        "../src/lib/input/*"
      ],
      "@saju": [
        "../src/lib/saju/index.ts"
      ],
      "@brand": [
        "../src/lib/brand/index.ts"
      ],
      "@saju-view": [
        "../src/lib/saju/view/index.ts"
      ],
      "@saju-view/notes": [
        "../src/lib/saju/view/notes.ts"
      ],
      "@consent/*": [
        "../src/lib/consent/*"
      ],
      "@db": [
        "../src/lib/db/index.ts"
      ],
      "@profile": [
        "../src/lib/profile/index.ts"
      ],
      "@account/*": [
        "../src/lib/account/*"
      ],
      "@reading/*": [
        "../src/lib/reading/*"
      ],
      "@brand/features": [
        "../src/lib/brand/features.ts"
      ],
      "@db-error": [
        "../app/db-error.ts"
      ],
      "@web-home/*": [
        "../src/lib/home/*"
      ],
      "@brand/links": [
        "../src/lib/brand/links.ts"
      ],
      "@reading/notes": [
        "../src/lib/reading/notes.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
