{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@input/*": [
        "../src/lib/input/*"
      ],
      "@saju": [
        "../src/lib/saju/index.ts"
      ],
      "@brand": [
        "../src/lib/brand/index.ts"
      ],
      "@saju-view": [
        "../src/lib/saju/view/index.ts"
      ],
      "@saju-view/notes": [
        "../src/lib/saju/view/notes.ts"
      ],
      "@consent/*": [
        "../src/lib/consent/*"
      ],
      "@db": [
        "../src/lib/db/index.ts"
      ],
      "@profile": [
        "../src/lib/profile/index.ts"
      ],
      "@account/*": [
        "../src/lib/account/*"
      ],
      "@survey": [
        "../src/lib/survey/index.ts"
      ],
      "@discovery": [
        "../src/lib/discovery/index.ts"
      ],
      "@discovery/copy": [
        "../src/lib/discovery/copy.ts"
      ],
      "@reading/*": [
        "../src/lib/reading/*"
      ],
      "@brand/*": [
        "../src/lib/brand/*"
      ],
      "@sign-in-again": [
        "../app/ui/sign-in-again.ts"
      ],
      "@db-error": [
        "../app/db-error.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
