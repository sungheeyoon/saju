{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ],
      "@input/*": [
        "../src/lib/input/*"
      ],
      "@saju": [
        "../src/lib/saju/index.ts"
      ],
      "@brand": [
        "../src/lib/brand/index.ts"
      ],
      "@saju-view": [
        "../src/lib/saju/view/index.ts"
      ],
      "@saju-view/notes": [
        "../src/lib/saju/view/notes.ts"
      ],
      "@consent/*": [
        "../src/lib/consent/*"
      ],
      "@db": [
        "../src/lib/db/index.ts"
      ],
      "@profile": [
        "../src/lib/profile/index.ts"
      ],
      "@account/*": [
        "../src/lib/account/*"
      ],
      "@db-error": [
        "../app/db-error.ts"
      ],
      "@matching/*": [
        "../src/lib/matching/*"
      ],
      "@discovery": [
        "../src/lib/discovery/index.ts"
      ],
      "@discovery/*": [
        "../src/lib/discovery/*"
      ],
      "@presence": [
        "../src/lib/presence/index.ts"
      ],
      "@reading/*": [
        "../src/lib/reading/*"
      ],
      "@chat/*": [
        "../src/lib/chat/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
