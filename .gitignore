# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
# 돈을 낸 실호출 결과가 떨어지는 자리 — 채점 전 원문이라 저장소에 올리지 않는다
/.reading-live
/.taste-live
/.taste-run-live

# next.js
/.next/
/.next-check/
# 옛 도구가 남긴 다른 빌드 자리도 — 무시하지 않으면 Tailwind 가 그 안의 이진 캐시를 클래스 후보로 읽어
# globals.css 파싱이 깨진다(2026-09-27, `.next-matching-test` 를 목록에서 뺀 뒤)
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 로컬 스택의 이름과 포트 기본값 — 비밀이 아니다(ADR 0096). 워크트리 값은 supabase/.env.local
!supabase/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# overlaps A/B 가 남기는 실행 산출물 — 결과이지 소스가 아니다
.ab-overlaps
