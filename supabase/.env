# 로컬 스택의 이름과 포트 — 기본값이다. main 체크아웃과 CI 는 이 값으로 선다(ADR 0096).
#
# 워크트리는 `npm run stack:slot -- N` 이 `supabase/.env.local` 에 제 값을 써서 덮는다 —
# 컨테이너 이름과 포트 묶음 전체가 갈라져야 한 기계의 두 워크트리가 서로의 DB 를 안 지운다.
# 셸의 환경변수가 둘보다 세다.
#
# **이 파일은 추적된다. 비밀 값을 넣지 않는다** — 넣을 것이 있으면 `.env.local` 이다.
SAJU_STACK_ID=saju
SAJU_API_PORT=54321
SAJU_DB_PORT=54322
SAJU_SHADOW_PORT=54320
SAJU_POOLER_PORT=54329
SAJU_STUDIO_PORT=54323
SAJU_SMTP_PORT=54324
SAJU_ANALYTICS_PORT=54327
SAJU_INSPECTOR_PORT=8083
SAJU_WEB_PORT=3000
# 인증이 돌려보내는 주소 — 웹 포트를 따라간다. 문자열이라 값이 없어도 CLI 가 조용히 넘어가니 빼지 않는다
SAJU_SITE_URL=http://127.0.0.1:3000
SAJU_SITE_URL_TLS=https://127.0.0.1:3000
SAJU_CHECK_PORT=3210
